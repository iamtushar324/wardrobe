#!/usr/bin/env python3
"""Import a folder of clothing photos into a Wardrobe server.

    wardrobe-ingest ~/Pictures/closet --note "Zara haul, Oct 2025" --store Zara --price 2990
    wardrobe-ingest ./tags --wait            # upload, wait for analysis, print what was found
    wardrobe-ingest ./photos --commit confident

Needs WARDROBE_URL and WARDROBE_TOKEN (an agent token from Settings -> Agents), or a JSON file at
~/.config/wardrobe/auth.json with {"url": ..., "token": ...}. Standard library only.
Purchase hints (store, price, ...) apply to every item in the import; leave them out when they differ.
"""

from __future__ import annotations

import argparse
import json
import mimetypes
import os
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

EXTS = {".jpg", ".jpeg", ".png", ".heic", ".heif", ".webp", ".avif"}
CHUNK = 6


def config() -> tuple[str, str]:
    url, token = os.environ.get("WARDROBE_URL", ""), os.environ.get("WARDROBE_TOKEN", "")
    p = Path(os.environ.get("WARDROBE_AUTH_FILE", Path.home() / ".config/wardrobe/auth.json"))
    if (not url or not token) and p.is_file():
        d = json.loads(p.read_text())
        url, token = url or d.get("url", ""), token or d.get("token", "")
    if not url or not token:
        sys.exit("set WARDROBE_URL and WARDROBE_TOKEN (or ~/.config/wardrobe/auth.json)")
    return url.rstrip("/"), token


def call(url: str, token: str, method: str, path: str, body=None, data: bytes | None = None, ctype: str | None = None):
    headers = {"Authorization": f"Bearer {token}"}
    if body is not None:
        data, ctype = json.dumps(body).encode(), "application/json"
    if ctype:
        headers["Content-Type"] = ctype
    req = urllib.request.Request(url + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=300) as r:  # noqa: S310 - user-provided server URL
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        sys.exit(f"{method} {path} failed: {e.code} {e.read().decode(errors='replace')[:300]}")


def multipart(files: list[Path], root: Path) -> tuple[bytes, str]:
    boundary = uuid.uuid4().hex
    out = bytearray()
    for f in files:
        name = str(f.relative_to(root)).replace(os.sep, "__")
        ctype = mimetypes.guess_type(f.name)[0] or "application/octet-stream"
        out += f'--{boundary}\r\nContent-Disposition: form-data; name="files"; filename="{name}"\r\nContent-Type: {ctype}\r\n\r\n'.encode()
        out += f.read_bytes() + b"\r\n"
    out += f"--{boundary}--\r\n".encode()
    return bytes(out), f"multipart/form-data; boundary={boundary}"


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("folder", type=Path)
    ap.add_argument("--note", default="", help="free text the AI reads, e.g. where/when bought")
    for h in ("store", "purchase-date", "price", "original-price", "currency", "brand", "gifted-by"):
        ap.add_argument(f"--{h}")
    ap.add_argument("--occasions", help="comma separated")
    ap.add_argument("--commit", choices=["none", "confident", "all"], default="none", help="add items without review")
    ap.add_argument("--no-analyze", action="store_true")
    ap.add_argument("--wait", action="store_true", help="wait for analysis and print the result")
    a = ap.parse_args()
    url, token = config()
    root = a.folder.expanduser().resolve()
    files = sorted(p for p in root.rglob("*") if p.is_file() and p.suffix.lower() in EXTS and not p.name.startswith("."))
    if not files:
        sys.exit(f"no photos found in {root}")
    hints = {k.replace("-", "_"): getattr(a, k.replace("-", "_")) for k in
             ("store", "purchase-date", "price", "original-price", "currency", "brand", "gifted-by") if getattr(a, k.replace("-", "_"))}
    for k in ("price", "original_price"):
        if k in hints:
            hints[k] = float(hints[k])
    if a.occasions:
        hints["occasions"] = [o.strip() for o in a.occasions.split(",") if o.strip()]
    b = call(url, token, "POST", "/api/v1/batches", {"note": a.note, "hints": hints, "auto_commit": a.commit, "analyze": not a.no_analyze})
    print(f"import {b['id']}: uploading {len(files)} photos", file=sys.stderr)
    failed = 0
    for i in range(0, len(files), CHUNK):
        data, ctype = multipart(files[i:i + CHUNK], root)
        r = call(url, token, "POST", f"/api/v1/batches/{b['id']}/photos", data=data, ctype=ctype)
        failed += sum(1 for x in r["results"] if x.get("error"))
        print(f"  {min(i + CHUNK, len(files))}/{len(files)}", file=sys.stderr)
    if failed:
        print(f"  {failed} file(s) could not be read", file=sys.stderr)
    if a.wait:
        while True:
            v = call(url, token, "GET", f"/api/v1/batches/{b['id']}")
            if v["batch"]["status"] not in ("open", "analyzing", "grouping"):
                break
            time.sleep(4)
        for p in v["proposals"]:
            d = p["data"]
            print(f"{p['id']}  {p['status']:<9} {round((p['confidence'] or 0) * 100):>3}%  {d.get('name')}"
                  + (f"  (same as {p['match']['name']})" if p.get("match") else ""))
    print(json.dumps({"batch_id": b["id"], "review": f"{url}/inbox/{b['id']}"}))


if __name__ == "__main__":
    main()
